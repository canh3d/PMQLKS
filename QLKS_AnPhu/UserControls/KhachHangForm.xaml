<Window x:Class="QLKS_AnPhu.View.KhachHangForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Khách hàng"
        Width="820"
        Height="680"
        MinWidth="780"
        MinHeight="640"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#EEF3F8">
    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border Margin="26"
            Background="White"
            CornerRadius="14"
            BorderBrush="#D8E2EE"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.14" />
        </Border.Effect>

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="TxtTieuDe"
                               Text="Thêm khách hàng"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#0B2545" />
                    <TextBlock Text="Nhập đầy đủ thông tin khách hàng để phục vụ đặt phòng, phiếu thuê và hóa đơn."
                               Margin="0,8,0,0"
                               FontSize="14"
                               Foreground="#64748B" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#EAF3FF"
                        CornerRadius="12"
                        Padding="14,8"
                        VerticalAlignment="Top">
                    <TextBlock Text="Hồ sơ khách hàng"
                               Foreground="#075985"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Họ tên" Style="{StaticResource LabelStyle}" />
                    <TextBox x:Name="TxtHoTen" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="Số điện thoại" Style="{StaticResource LabelStyle}" />
                    <TextBox x:Name="TxtSDT" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="CCCD/CMND" Style="{StaticResource LabelStyle}" />
                    <TextBox x:Name="TxtCCCD" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="Ngày sinh" Style="{StaticResource LabelStyle}" />
                    <DatePicker x:Name="DpNgaySinh" />
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="0">
                    <TextBlock Text="Giới tính" Style="{StaticResource LabelStyle}" />
                    <ComboBox x:Name="CboGioiTinh" SelectedIndex="0">
                        <ComboBoxItem Content="Nam" />
                        <ComboBoxItem Content="Nữ" />
                        <ComboBoxItem Content="Khác" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.Column="2">
                    <TextBlock Text="Loại khách" Style="{StaticResource LabelStyle}" />
                    <ComboBox x:Name="CboLoaiKhach" SelectedIndex="0">
                        <ComboBoxItem Content="Thường" />
                        <ComboBoxItem Content="VIP" />
                    </ComboBox>
                </StackPanel>

                <Grid Grid.Row="6" Grid.ColumnSpan="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Trạng thái" Style="{StaticResource LabelStyle}" />
                        <ComboBox x:Name="CboTrangThai" SelectedIndex="0">
                            <ComboBoxItem Content="Đang hoạt động" />
                            <ComboBoxItem Content="Tạm khóa" />
                            <ComboBoxItem Content="Ngừng sử dụng" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="Địa chỉ" Style="{StaticResource LabelStyle}" />
                        <TextBox x:Name="TxtDiaChi" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                        <TextBlock Text="Ghi chú" Style="{StaticResource LabelStyle}" />
                        <TextBox x:Name="TxtGhiChu"
                                 MinHeight="112"
                                 Padding="13,10"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    Margin="0,18,0,0"
                    Background="#FEF2F2"
                    CornerRadius="8"
                    Padding="12,9">
                <TextBlock x:Name="TxtThongBao"
                           Foreground="#DC2626"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
            </Border>

            <Grid Grid.Row="3" Margin="0,22,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="142"
                            Height="44"
                            Background="#16A34A"
                            BorderBrush="#15803D"
                            Foreground="White"
                            FontSize="15"
                            FontWeight="Bold"
                            Click="BtnLuu_Click"
                            Content="Lưu" />
                    <Button Width="132"
                            Height="44"
                            Margin="14,0,0,0"
                            Background="#64748B"
                            BorderBrush="#475569"
                            Foreground="White"
                            FontSize="15"
                            FontWeight="Bold"
                            Click="BtnHuy_Click"
                            Content="Hủy" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
