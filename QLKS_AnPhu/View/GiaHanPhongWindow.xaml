<Window x:Class="QLKS_AnPhu.View.GiaHanPhongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Gia hạn phòng" Width="760" Height="680"
        MinWidth="740" MinHeight="660"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="QuickButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#EFF6FF" />
            <Setter Property="BorderBrush" Value="#BFDBFE" />
            <Setter Property="Foreground" Value="#1D4ED8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="TimeTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Gia hạn phòng" FontSize="24" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock Text="Chọn nhanh thời gian gia hạn hoặc nhập ngày giờ trả mới."
                           Margin="0,6,0,0" FontSize="13" Foreground="#64748B" />
            </StackPanel>

            <Border Grid.Column="1" Padding="14,8" CornerRadius="10" Background="#E0F2FE" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Bed" Width="18" Height="18" Foreground="#0284C7" Margin="0,0,8,0" />
                    <TextBlock x:Name="TxtPhong" Foreground="#075985" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Margin="0,24,0,22" Padding="24" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Padding="16" CornerRadius="10" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Giờ trả hiện tại" Foreground="#64748B" FontSize="12" />
                            <TextBlock x:Name="TxtNgayTraCu" Margin="0,5,0,0" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Giờ trả mới" Foreground="#64748B" FontSize="12" />
                            <TextBlock x:Name="TxtNgayTraMoiPreview" Margin="0,5,0,0" FontSize="18" FontWeight="Bold" Foreground="#16A34A" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Chọn nhanh" Foreground="#0F172A" FontWeight="Bold" Margin="0,0,0,10" />
                    <WrapPanel>
                        <Button Style="{StaticResource QuickButton}" Tag="1" Click="QuickExtend_Click">+1 giờ</Button>
                        <Button Style="{StaticResource QuickButton}" Tag="2" Click="QuickExtend_Click">+2 giờ</Button>
                        <Button Style="{StaticResource QuickButton}" Tag="4" Click="QuickExtend_Click">+4 giờ</Button>
                        <Button Style="{StaticResource QuickButton}" Tag="8" Click="QuickExtend_Click">+8 giờ</Button>
                        <Button Style="{StaticResource QuickButton}" Tag="24" Click="QuickExtend_Click">+1 ngày</Button>
                        <Button Style="{StaticResource QuickButton}" Tag="48" Click="QuickExtend_Click">+2 ngày</Button>
                    </WrapPanel>
                </StackPanel>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Ngày trả mới" Style="{StaticResource FieldLabel}" />
                    <DatePicker x:Name="DpNgayTraMoi"
                                Grid.Column="1"
                                Height="38"
                                VerticalContentAlignment="Center"
                                SelectedDateChanged="NgayTraMoi_Changed" />

                    <TextBlock Grid.Column="3" Text="Giờ" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TxtGioTraMoi"
                             Grid.Column="4"
                             Style="{StaticResource TimeTextBox}"
                             TextChanged="NgayTraMoi_Changed"
                             LostFocus="TxtGioTraMoi_LostFocus" />
                </Grid>

                <Border Grid.Row="6" Padding="16" CornerRadius="10" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial Kind="InformationOutline" Width="20" Height="20" Foreground="#16A34A" Margin="0,1,10,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="TxtPreview" Foreground="#166534" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="TxtTienGiaHan" Margin="0,6,0,0" FontSize="18" FontWeight="Bold" Foreground="#15803D" TextWrapping="Wrap" />
                            <TextBlock x:Name="TxtWarning" Margin="0,5,0,0" Foreground="#B45309" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" LastChildFill="False">
            <TextBlock Text="Hệ thống sẽ kiểm tra lịch đặt của phòng trước khi gia hạn."
                       VerticalAlignment="Center"
                       Foreground="#64748B"
                       TextWrapping="Wrap" />

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BtnXacNhan"
                        Style="{StaticResource ActionButton}"
                        Background="#16A34A"
                        BorderBrush="#15803D"
                        Click="BtnXacNhan_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="CalendarPlus" Width="16" Height="16" Margin="0,0,7,0" />
                        <TextBlock Text="Xác nhận gia hạn" />
                    </StackPanel>
                </Button>
                <Button Margin="10,0,0,0"
                        Style="{StaticResource ActionButton}"
                        Background="#64748B"
                        BorderBrush="#475569"
                        Click="BtnDong_Click">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Close" Width="16" Height="16" Margin="0,0,7,0" />
                        <TextBlock Text="Đóng" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

