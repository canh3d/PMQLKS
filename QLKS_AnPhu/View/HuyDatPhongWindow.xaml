<Window x:Class="QLKS_AnPhu.View.HuyDatPhongWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Xác nhận hủy đặt phòng"
        Width="560"
        Height="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="46" Height="46" Background="#FFEDD5" CornerRadius="23" VerticalAlignment="Top">
                <iconPacks:PackIconMaterial Kind="AlertCircle" Width="26" Height="26"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="#EA580C" />
            </Border>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Xác nhận hủy đặt phòng"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#0F172A" />
                <TextBlock x:Name="TxtMoTa"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           FontSize="14"
                           Foreground="#475569" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,20,0,14"
                Padding="16"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Tiền cọc" Foreground="#64748B" />
                    <TextBlock x:Name="TxtTienCoc" Margin="0,6,0,0" FontSize="20" FontWeight="Bold" Foreground="#0F172A" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Giữ lại" Foreground="#64748B" />
                    <TextBlock x:Name="TxtGiuLai" Margin="0,6,0,0" FontSize="20" FontWeight="Bold" Foreground="#DC2626" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Hoàn khách" Foreground="#64748B" />
                    <TextBlock x:Name="TxtHoanTra" Margin="0,6,0,0" FontSize="20" FontWeight="Bold" Foreground="#16A34A" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="TxtChinhSach"
                       TextWrapping="Wrap"
                       FontWeight="SemiBold"
                       Foreground="#0B3A5B" />
            <DataGrid x:Name="DgChiTiet"
                      Grid.Row="1"
                      Margin="0,10,0,0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Phiếu" Binding="{Binding MaDatPhong}" Width="70" />
                    <DataGridTextColumn Header="Nhận dự kiến" Binding="{Binding NgayNhanText}" Width="140" />
                    <DataGridTextColumn Header="Cọc" Binding="{Binding TienCocText}" Width="*" />
                    <DataGridTextColumn Header="Giữ" Binding="{Binding GiuLaiText}" Width="*" />
                    <DataGridTextColumn Header="Hoàn" Binding="{Binding HoanTraText}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Width="138" Height="40" Background="#DC2626" Foreground="White"
                    BorderBrush="#B91C1C" FontWeight="SemiBold" Click="BtnXacNhan_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Cancel" Width="16" Height="16" Margin="0,0,7,0" />
                    <TextBlock Text="Xác nhận hủy" />
                </StackPanel>
            </Button>
            <Button Width="96" Height="40" Margin="10,0,0,0" Background="#64748B"
                    Foreground="White" BorderBrush="#475569" FontWeight="SemiBold" Click="BtnDong_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Close" Width="16" Height="16" Margin="0,0,7,0" />
                    <TextBlock Text="Đóng" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
