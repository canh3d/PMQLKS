<Window x:Class="QLKS_AnPhu.View.HoaDonChiTietWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Chi tiết hóa đơn"
        Width="1260"
        Height="760"
        MinWidth="1060"
        MinHeight="660"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9">
    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Style>
                <Style TargetType="iconPacks:PackIconMaterial">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Style>
            </Style.Resources>
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#F8FAFC">
            <TextBlock Text="CHI TIẾT HÓA ĐƠN"
                       Margin="26,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="#0B2545" />
            <TextBlock x:Name="TxtTieuDeHoaDon"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#0B2545" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,22,28,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1.1*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource InfoCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Thông tin hóa đơn" FontSize="16" FontWeight="Bold" Foreground="#0B2545" />
                            <TextBlock x:Name="TxtMaHoaDon" Margin="0,12,0,0" FontSize="15" Foreground="#0F172A" />
                            <TextBlock x:Name="TxtNgayLap" Margin="0,7,0,0" FontSize="15" Foreground="#0F172A" />
                            <Border Margin="0,12,0,0" Background="#FEF9C3" CornerRadius="4" Padding="10,6">
                                <TextBlock x:Name="TxtTrangThai" FontSize="15" FontWeight="SemiBold" Foreground="#713F12" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource InfoCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Thông tin khách hàng" FontSize="16" FontWeight="Bold" Foreground="#0B2545" />
                            <TextBlock x:Name="TxtKhachHang" Margin="0,12,0,0" FontSize="15" Foreground="#0F172A" />
                            <TextBlock x:Name="TxtSdt" Margin="0,7,0,0" FontSize="15" Foreground="#0F172A" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource InfoCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Thông tin lưu trú" FontSize="16" FontWeight="Bold" Foreground="#0B2545" />
                            <TextBlock x:Name="TxtPhong" Margin="0,12,0,0" FontSize="15" Foreground="#0F172A" />
                            <TextBlock x:Name="TxtLoaiPhong" Margin="0,7,0,0" FontSize="15" Foreground="#0F172A" />
                            <TextBlock x:Name="TxtThoiGianThue" Margin="0,7,0,0" FontSize="15" Foreground="#0F172A" TextWrapping="Wrap" />
                            <TextBlock x:Name="TxtThoiLuong" Margin="0,7,0,0" FontSize="15" Foreground="#0F172A" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="330" />
                    </Grid.ColumnDefinitions>

                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Chi tiết thanh toán" FontSize="18" FontWeight="Bold" Foreground="#0B2545" />

                            <DataGrid x:Name="DgChiTietThanhToan"
                                      Grid.Row="1"
                                      Margin="0,14,0,0"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      RowHeight="34"
                                      MinHeight="290"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderBrush="#CBD5E1"
                                      BorderThickness="1">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Height" Value="36" />
                                        <Setter Property="Background" Value="#EAF0F6" />
                                        <Setter Property="Foreground" Value="#334155" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="BorderBrush" Value="#CBD5E1" />
                                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="58" />
                                    <DataGridTextColumn Header="Khoản mục" Binding="{Binding Ten}" Width="*" />
                                    <DataGridTextColumn Header="Phòng" Binding="{Binding SoPhong}" Width="90" />
                                    <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGiaText}" Width="130" />
                                    <DataGridTextColumn Header="SL" Binding="{Binding SoLuongText}" Width="70" />
                                    <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTienText}" Width="150" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Ghi chú hóa đơn" FontSize="16" FontWeight="Bold" Foreground="#0B2545" />
                                <TextBlock x:Name="TxtGhiChuHoaDon" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="14" Foreground="#475569" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,16,0,0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Tạm tính" Foreground="#334155" />
                                    <TextBlock x:Name="TxtTamTinh" HorizontalAlignment="Right" Foreground="#0F172A" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Giảm giá / cọc" Foreground="#334155" />
                                    <TextBlock x:Name="TxtGiamGiaCoc" HorizontalAlignment="Right" Foreground="#0F172A" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Đã thanh toán" Foreground="#334155" />
                                    <TextBlock x:Name="TxtDaThanhToan" HorizontalAlignment="Right" Foreground="#0F172A" />
                                </Grid>
                                <Border Margin="0,4,0,12" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" />
                                <Grid>
                                    <TextBlock x:Name="TxtTongTienLabel" Text="Cần thanh toán" FontSize="18" FontWeight="Bold" Foreground="#0B2545" />
                                    <TextBlock x:Name="TxtTongTien" HorizontalAlignment="Right" FontSize="22" FontWeight="Bold" Foreground="#DC2626" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,28,0">
            <Button x:Name="BtnThanhToan" Style="{StaticResource ActionButtonStyle}" Background="#22C55E" BorderBrush="#16A34A" Click="BtnThanhToan_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="CashCheck" Width="14" Height="14" Margin="0,0,7,0" />
                    <TextBlock Text="Thanh toán" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ActionButtonStyle}" Margin="10,0,0,0" Background="#F59E0B" BorderBrush="#D97706" Click="BtnInHoaDon_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Printer" Width="14" Height="14" Margin="0,0,7,0" />
                    <TextBlock Text="In hóa đơn" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ActionButtonStyle}" Margin="10,0,0,0" Background="#64748B" BorderBrush="#475569" Click="BtnDong_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" Margin="0,0,7,0" />
                    <TextBlock Text="Đóng" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
