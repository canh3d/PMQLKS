<Window x:Class="QLKS_AnPhu.View.XacNhanThanhToanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Xác nhận thanh toán" Width="470" Height="250"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F8FAFC">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="44" Height="44" VerticalAlignment="Top" Background="#DBEAFE" CornerRadius="22">
                <iconPacks:PackIconMaterial Kind="CashCheck" Width="24" Height="24"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Foreground="#2563EB" />
            </Border>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="Xác nhận thanh toán hóa đơn" FontSize="19"
                           FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock x:Name="TxtNoiDung" Margin="0,10,0,0"
                           TextWrapping="Wrap" FontSize="14" Foreground="#475569" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="126" Height="40" Background="#16A34A" Foreground="White"
                    BorderBrush="#15803D" FontWeight="SemiBold" Click="BtnXacNhan_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Check" Width="16" Height="16" Margin="0,0,7,0" />
                    <TextBlock Text="Xác nhận" />
                </StackPanel>
            </Button>
            <Button Width="100" Height="40" Margin="10,0,0,0" Background="#64748B"
                    Foreground="White" BorderBrush="#475569" FontWeight="SemiBold" Click="BtnHuy_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Close" Width="16" Height="16" Margin="0,0,7,0" />
                    <TextBlock Text="Hủy" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
