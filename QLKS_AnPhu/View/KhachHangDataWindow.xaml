<Window x:Class="QLKS_AnPhu.View.KhachHangDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Dữ liệu khách hàng"
        Width="1120"
        Height="650"
        MinWidth="900"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FB"
        FontFamily="Segoe UI"
        Language="vi-VN"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="24"
                          ShadowDepth="5"
                          Opacity="0.11"
                          Color="#0F172A" />

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground"
                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Style>
                <Style TargetType="iconPacks:PackIconMaterial">
                    <Setter Property="Foreground"
                            Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Style>
            </Style.Resources>
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="#0F3B62" />
            <Setter Property="BorderBrush" Value="#0F3B62" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#164F7D" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#164F7D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0B2F4E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomerDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E8EDF4" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="RowHeight" Value="40" />
            <Setter Property="ColumnHeaderHeight" Value="42" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF3F8" />
            <Setter Property="Foreground" Value="#24364B" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderBrush" Value="#D8E0EA" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F8FAFC" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF5FF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCEBFF" />
                    <Setter Property="Foreground" Value="#172033" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                CornerRadius="16"
                Effect="{StaticResource CardShadow}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F3555" Offset="0" />
                    <GradientStop Color="#0B4EA2" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="22,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="58"
                        Height="58"
                        Background="#26FFFFFF"
                        CornerRadius="16">
                    <Grid>
                        <iconPacks:PackIconMaterial x:Name="HistoryIcon"
                                                    Kind="History"
                                                    Width="30"
                                                    Height="30"
                                                    Foreground="White"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                        <iconPacks:PackIconMaterial x:Name="InvoiceIcon"
                                                    Kind="FileDocument"
                                                    Width="30"
                                                    Height="30"
                                                    Foreground="White"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Visibility="Collapsed" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTieuDe"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="White" />
                    <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Account"
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,6,0"
                                                    Foreground="#D8E8FA" />
                        <TextBlock x:Name="TxtKhachHang"
                                   FontSize="13"
                                   Foreground="#E5EFFA" />
                        <Border Width="1"
                                Height="14"
                                Margin="12,0"
                                Background="#66FFFFFF" />
                        <iconPacks:PackIconMaterial Kind="Phone"
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,6,0"
                                                    Foreground="#D8E8FA" />
                        <TextBlock x:Name="TxtLienHe"
                                   FontSize="13"
                                   Foreground="#E5EFFA" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="3"
                        Padding="14,7"
                        VerticalAlignment="Center"
                        Background="#26FFFFFF"
                        BorderBrush="#55FFFFFF"
                        BorderThickness="1"
                        CornerRadius="14">
                    <TextBlock x:Name="TxtCheDo"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="White" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DCE3EC"
                BorderThickness="1"
                CornerRadius="14"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DỮ LIỆU CHI TIẾT"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#172033" />
                        <TextBlock x:Name="TxtThongBao"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="#667085"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Padding="12,6"
                            VerticalAlignment="Center"
                            Background="#EAF2FF"
                            CornerRadius="12">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Database"
                                                        Width="14"
                                                        Height="14"
                                                        Margin="0,0,7,0"
                                                        Foreground="#245BFF" />
                            <TextBlock x:Name="TxtTongBanGhi"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#245BFF" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1"
                        Margin="14,0,14,14"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        ClipToBounds="True">
                    <Grid>
                        <DataGrid x:Name="DgData"
                                  Style="{StaticResource CustomerDataGridStyle}" />

                        <StackPanel x:Name="EmptyState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                            <Border Width="58"
                                    Height="58"
                                    HorizontalAlignment="Center"
                                    Background="#EEF3F8"
                                    CornerRadius="29">
                                <iconPacks:PackIconMaterial Kind="DatabaseOff"
                                                            Width="27"
                                                            Height="27"
                                                            Foreground="#8290A3"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Margin="0,14,0,0"
                                       HorizontalAlignment="Center"
                                       Text="Chưa có dữ liệu"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#334155" />
                            <TextBlock Margin="0,5,0,0"
                                       HorizontalAlignment="Center"
                                       Text="Khách hàng này chưa phát sinh bản ghi phù hợp."
                                       FontSize="12"
                                       Foreground="#7A8798" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <TextBlock VerticalAlignment="Center"
                       Text="Dữ liệu được sắp xếp từ mới nhất đến cũ nhất"
                       FontSize="12"
                       Foreground="#7A8798" />

            <Button Width="112"
                    HorizontalAlignment="Right"
                    Style="{StaticResource CloseButtonStyle}"
                    Click="BtnDong_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Close"
                                                Width="15"
                                                Height="15"
                                                Margin="0,0,7,0" />
                    <TextBlock Text="Đóng" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
