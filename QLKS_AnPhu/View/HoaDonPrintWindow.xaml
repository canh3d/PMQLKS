<Window x:Class="QLKS_AnPhu.View.HoaDonPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Bill thanh toán"
        Width="900"
        Height="760"
        MinWidth="820"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9">
    <Window.Resources>
        <Style x:Key="TopButtonStyle" TargetType="Button">
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Style>
                <Style TargetType="iconPacks:PackIconMaterial">
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Style>
            </Style.Resources>
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#F8FAFC">
            <TextBlock Text="HÓA ĐƠN THANH TOÁN"
                       Margin="26,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="16"
                       Foreground="#0B2545" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                <Button Width="92" Style="{StaticResource TopButtonStyle}" Background="#22C55E" BorderBrush="#16A34A" Click="BtnIn_Click">
                    <TextBlock Text="In" />
                </Button>
                <Button Width="120" Margin="12,0,0,0" Style="{StaticResource TopButtonStyle}" Background="#2563EB" BorderBrush="#1D4ED8" Click="BtnXuatAnh_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Image" Width="14" Height="14" Margin="0,0,6,0" />
                        <TextBlock Text="Xuất ảnh" />
                    </StackPanel>
                </Button>
                <Button Width="132" Margin="12,0,0,0" Style="{StaticResource TopButtonStyle}" Background="#F59E0B" BorderBrush="#D97706" Click="BtnXuatExcel_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="MicrosoftExcel" Width="14" Height="14" Margin="0,0,6,0" />
                        <TextBlock Text="Xuất Excel" />
                    </StackPanel>
                </Button>
                <Button Width="88" Margin="12,0,0,0" Style="{StaticResource TopButtonStyle}" Background="#64748B" BorderBrush="#475569" Click="BtnDong_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Close" Width="13" Height="13" Margin="0,0,6,0" />
                        <TextBlock Text="Đóng" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="White">
            <Border x:Name="InvoicePaper"
                    Width="760"
                    MinHeight="640"
                    Padding="30,30"
                    HorizontalAlignment="Center"
                    Margin="16,0">
                <Border.Background>
                    <ImageBrush ImageSource="/Res/001.jpg"
                                Stretch="UniformToFill"
                                Opacity="0.16" />
                </Border.Background>
                <StackPanel x:Name="PrintSurface">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="0.85*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="KHÁCH SẠN AN PHÚ" FontSize="22" FontWeight="Bold" Foreground="#0B2545" />
                            <TextBlock Text="Dịch vụ lưu trú - thanh toán minh bạch" Margin="0,6,0,0" FontSize="14" Foreground="#475569" />
                            <TextBlock Text="Thông tin liên hệ được cung cấp tại quầy lễ tân" Margin="0,18,0,0" FontSize="14" Foreground="#0F172A" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="18" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <TextBlock x:Name="TxtTieuDeHoaDon" Text="Hóa đơn" FontSize="22" FontWeight="Bold" Foreground="#0B2545" />
                                <TextBlock x:Name="TxtMaHoaDon" Margin="0,16,0,0" FontSize="14" Foreground="#0F172A" />
                                <TextBlock x:Name="TxtNgayLap" Margin="0,6,0,0" FontSize="14" Foreground="#0F172A" />
                                <TextBlock x:Name="TxtNhanVienLap" Margin="0,4,0,0" FontSize="12" Foreground="#0F172A" />
                                <TextBlock x:Name="TxtTrangThai" Margin="0,6,0,0" FontSize="14" FontWeight="SemiBold" Foreground="#15803D" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="16" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Thông tin khách hàng" FontWeight="Bold" Foreground="#0B2545" FontSize="16" />
                                <TextBlock x:Name="TxtKhachHang" Margin="0,10,0,0" FontSize="15" Foreground="#0F172A" />
                                <TextBlock x:Name="TxtSdt" Margin="0,6,0,0" FontSize="15" Foreground="#0F172A" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="16" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Thông tin lưu trú" FontWeight="Bold" Foreground="#0B2545" FontSize="16" />
                                <TextBlock x:Name="TxtSoPhong" Margin="0,10,0,0" FontSize="15" Foreground="#0F172A" />
                                <TextBlock x:Name="TxtThoiGianThue" Margin="0,6,0,0" FontSize="15" Foreground="#0F172A" TextWrapping="Wrap" />
                                <TextBlock x:Name="TxtLoaiPhong" Margin="0,6,0,0" FontSize="15" Foreground="#0F172A" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="Chi tiết thanh toán" Margin="0,20,0,0" FontSize="16" FontWeight="Bold" Foreground="#0B2545" />

                    <Grid Margin="0,12,0,0" Background="#EAF0F6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="130" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="STT" Padding="8" FontWeight="SemiBold" Foreground="#334155" />
                        <TextBlock Grid.Column="1" Text="Khoản mục" Padding="8" FontWeight="SemiBold" Foreground="#334155" />
                        <TextBlock Grid.Column="2" Text="Phòng" Padding="8" FontWeight="SemiBold" Foreground="#334155" />
                        <TextBlock Grid.Column="3" Text="Đơn giá" Padding="8" FontWeight="SemiBold" Foreground="#334155" TextAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="SL" Padding="8" FontWeight="SemiBold" Foreground="#334155" TextAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="Thành tiền" Padding="8" FontWeight="SemiBold" Foreground="#334155" TextAlignment="Right" />
                    </Grid>

                    <ItemsControl x:Name="ItemsChiTietHoaDon">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Background="White">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="118" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Stt}" Padding="8,9" Foreground="#0F172A" />
                                    <TextBlock Grid.Column="1" Text="{Binding Ten}" Padding="8,9" Foreground="#0F172A" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="2" Text="{Binding SoPhong}" Padding="8,9" Foreground="#0F172A" />
                                    <TextBlock Grid.Column="3" Text="{Binding DonGiaText}" Padding="8,9" Foreground="#0F172A" TextAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{Binding SoLuongText}" Padding="8,9" Foreground="#0F172A" TextAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{Binding ThanhTienText}" Padding="8,9" Foreground="#0F172A" TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Margin="0,4,0,0" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" />

                    <Grid Margin="0,26,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>
                        <Border Padding="16" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Ghi chú" FontWeight="Bold" Foreground="#0B2545" />
                                <TextBlock x:Name="TxtGhiChuHoaDon" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#475569" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="22,0,0,0">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Tạm tính" Foreground="#334155" />
                                <TextBlock x:Name="TxtTamTinh" HorizontalAlignment="Right" Foreground="#0F172A" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Giảm giá / cọc" Foreground="#334155" />
                                <TextBlock x:Name="TxtGiamGiaCoc" HorizontalAlignment="Right" Foreground="#0F172A" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Đã thanh toán" Foreground="#334155" />
                                <TextBlock x:Name="TxtDaThanhToan" HorizontalAlignment="Right" Foreground="#0F172A" />
                            </Grid>
                            <Border Margin="0,4,0,10" BorderBrush="#CBD5E1" BorderThickness="0,1,0,0" />
                            <Grid>
                                <TextBlock x:Name="TxtTongTienLabel" Text="Cần thanh toán" FontSize="16" FontWeight="Bold" Foreground="#0B2545" />
                                <TextBlock x:Name="TxtTongTien" HorizontalAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#DC2626" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,26,0,0" BorderBrush="#94A3B8" BorderThickness="0,1,0,0" />

                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Cảm ơn quý khách!" FontSize="20" FontWeight="Bold" Foreground="#0B2545" />
                        <TextBlock Grid.Column="1"
                                   Text="Vui lòng kiểm tra thông tin trước khi rời quầy."
                                   FontSize="16"
                                   Foreground="#0F172A"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
