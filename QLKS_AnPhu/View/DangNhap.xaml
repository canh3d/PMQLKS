<Window x:Class="QLKS_AnPhu.View.DangNhap"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Đăng nhập"
        Height="660"
        Width="1120"
        MinHeight="620"
        MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <DropShadowEffect x:Key="LoginShellShadow" BlurRadius="36" ShadowDepth="10" Opacity="0.16" Color="#0F172A" />
        <DropShadowEffect x:Key="LoginButtonShadow" BlurRadius="22" ShadowDepth="5" Opacity="0.20" Color="#1D4ED8" />

        <Style x:Key="LoginLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="LoginInputBorderStyle" TargetType="Border">
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="LoginPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="LoginPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Effect" Value="{StaticResource LoginButtonShadow}" />
        </Style>

        <Style x:Key="LoginOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource AppOutlineButtonStyle}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Effect" Value="{x:Null}" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Border Margin="28"
                CornerRadius="26"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Effect="{StaticResource LoginShellShadow}"
                ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0F2F4D" Offset="0" />
                            <GradientStop Color="#1D4ED8" Offset="0.62" />
                            <GradientStop Color="#8B5CF6" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid Margin="58">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="52" Height="52" CornerRadius="17" Background="#FFFFFF1F" BorderBrush="#FFFFFF3F" BorderThickness="1">
                                <iconPacks:PackIconMaterial Kind="HomeCity" Width="28" Height="28" Foreground="White" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="AN PHÚ HOTEL" FontSize="20" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="Management Suite" Margin="0,3,0,0" FontSize="12" Foreground="#DBEAFE" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <TextBlock Text="Quản lý khách sạn gọn gàng hơn"
                                       Width="440"
                                       HorizontalAlignment="Left"
                                       FontSize="31"
                                       FontWeight="SemiBold"
                                       LineHeight="40"
                                       Foreground="White"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Theo dõi phòng, khách hàng, đặt phòng và thanh toán trong một hệ thống thống nhất."
                                       Width="430"
                                       Margin="0,18,0,0"
                                       FontSize="16"
                                       LineHeight="26"
                                       Foreground="#E0F2FE"
                                       TextWrapping="Wrap" />
                            <Border Width="74" Height="4" Margin="0,32,0,0" HorizontalAlignment="Left" CornerRadius="3" Background="#F59E0B" />
                        </StackPanel>

                        <Border Grid.Row="2"
                                Width="430"
                                HorizontalAlignment="Left"
                                Padding="18,14"
                                CornerRadius="18"
                                Background="#FFFFFF18"
                                BorderBrush="#FFFFFF30"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ShieldCheck" Width="22" Height="22" Foreground="#FDE68A" Margin="0,0,10,0" />
                                <TextBlock Text="Bảo mật tài khoản nhân viên và phân quyền theo vai trò"
                                           Width="350"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="#111827"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Background="#F8FAFC">
                    <Border Width="430"
                            Padding="40"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            CornerRadius="22"
                            Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Effect="{StaticResource SoftShadow}">
                        <StackPanel>
                            <Border Width="54" Height="54" CornerRadius="18" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2563EB" Offset="0" />
                                        <GradientStop Color="#06B6D4" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <iconPacks:PackIconMaterial Kind="AccountKey" Width="28" Height="28" Foreground="White" />
                            </Border>

                            <TextBlock Text="Đăng nhập"
                                       Margin="0,20,0,0"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMainBrush}" />
                            <TextBlock Text="Nhập thông tin tài khoản để tiếp tục"
                                       Margin="0,8,0,30"
                                       FontSize="14"
                                       Foreground="{StaticResource TextMutedBrush}" />

                            <TextBlock Text="Tên đăng nhập" Style="{StaticResource LoginLabelStyle}" />
                            <Border Style="{StaticResource LoginInputBorderStyle}">
                                <Grid Margin="14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconMaterial Kind="AccountOutline" Width="20" Height="20" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,10,0" />
                                    <TextBox x:Name="TxtTenDangNhap"
                                             Grid.Column="1"
                                             Style="{StaticResource LoginTextBoxStyle}"
                                             KeyDown="Input_KeyDown" />
                                </Grid>
                            </Border>

                            <TextBlock Text="Mật khẩu" Style="{StaticResource LoginLabelStyle}" Margin="0,18,0,8" />
                            <Border Style="{StaticResource LoginInputBorderStyle}">
                                <Grid Margin="14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <iconPacks:PackIconMaterial Kind="LockOutline" Width="20" Height="20" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,10,0" />
                                    <PasswordBox x:Name="TxtMatKhau"
                                                 Grid.Column="1"
                                                 Style="{StaticResource LoginPasswordBoxStyle}"
                                                 KeyDown="Input_KeyDown" />
                                </Grid>
                            </Border>

                            <TextBlock x:Name="TxtThongBao"
                                       Margin="0,14,0,0"
                                       MinHeight="22"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource DangerBrush}"
                                       TextWrapping="Wrap" />

                            <Button Margin="0,16,0,0"
                                    Style="{StaticResource LoginPrimaryButtonStyle}"
                                    Click="BtnDangNhap_Click">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="Login" Width="18" Height="18" Margin="0,0,8,0" />
                                    <TextBlock Text="Đăng nhập" Style="{StaticResource ButtonContentTextStyle}" />
                                </StackPanel>
                            </Button>

                            <Button Margin="0,12,0,0"
                                    Style="{StaticResource LoginOutlineButtonStyle}"
                                    Click="BtnThoat_Click">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="CloseCircleOutline" Width="18" Height="18" Margin="0,0,8,0" />
                                    <TextBlock Text="Thoát" Style="{StaticResource ButtonContentTextStyle}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
