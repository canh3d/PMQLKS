<Window x:Class="QLKS_AnPhu.View.ThanhToanCheckOutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Xác nhận thanh toán trả phòng"
        Width="820" Height="690" MinWidth="820" MinHeight="690"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Xác nhận thanh toán trả phòng" FontSize="25" FontWeight="Bold" Foreground="#0F172A" />
            <TextBlock x:Name="TxtMoTa" Margin="0,7,0,0" FontSize="14" Foreground="#475569" />
        </StackPanel>
        <Border Grid.Row="1" Margin="0,20,0,14" Padding="16" Background="#EFF6FF"
                BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Thời gian trả dự kiến" Foreground="#64748B" />
                    <TextBlock x:Name="TxtTraDuKien" Margin="0,4,0,0" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Thời gian trả thực tế" Foreground="#64748B" />
                    <TextBlock x:Name="TxtTraThucTe" Margin="0,4,0,0" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" Padding="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
            <DataGrid x:Name="DgKhoanThanhToan" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="48" ColumnHeaderHeight="42">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Khoản mục" Binding="{Binding Ten}" Width="*" />
                    <DataGridTextColumn Header="Cách tính" Binding="{Binding CachTinh}" Width="300" />
                    <DataGridTextColumn Header="Số tiền" Binding="{Binding SoTienHienThi}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LaKhoanHoan}" Value="True">
                                        <Setter Property="Foreground" Value="#15803D" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Border Grid.Row="3" Margin="0,14,0,18" Padding="18" Background="White"
                BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="TxtKetLuan" FontSize="17" FontWeight="Bold" />
                    <TextBlock x:Name="TxtGhiChu" Margin="0,6,25,0" TextWrapping="Wrap" Foreground="#64748B" />
                </StackPanel>
                <TextBlock x:Name="TxtTongTien" Grid.Column="1" HorizontalAlignment="Right"
                           VerticalAlignment="Center" FontSize="23" FontWeight="Bold" Foreground="#DC2626" />
            </Grid>
        </Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,10,0" Style="{StaticResource ActionButton}"
                    Background="#F59E0B" BorderBrush="#D97706" Click="BtnThanhToanSau_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="ClockOutline" Width="17" Height="17" Margin="0,0,7,0" />
                    <TextBlock Text="Thanh toán sau" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ActionButton}" Background="#16A34A" BorderBrush="#15803D"
                    Click="BtnXacNhan_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="CashCheck" Width="17" Height="17" Margin="0,0,7,0" />
                    <TextBlock Text="Xác nhận thanh toán và trả phòng" />
                </StackPanel>
            </Button>
            <Button Margin="10,0,0,0" Style="{StaticResource ActionButton}"
                    Background="#64748B" BorderBrush="#475569" Click="BtnHuy_Click">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Close" Width="16" Height="16" Margin="0,0,7,0" />
                    <TextBlock Text="Hủy" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
